# Copy to deploy/.env and fill in. Never commit the filled-in file.
SITE_DOMAIN=review.example.com
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
# 32+ random characters, e.g. from: openssl rand -base64 36
SESSION_SECRET=
# The outside reviewer's sign-in (password: 12+ characters; send it to him separately from the link).
REVIEWER_LOGIN=
REVIEWER_NAME=
REVIEWER_PASSWORD=
# Your own sign-in, to see the same screens and read feedback.
OWNER_LOGIN=
OWNER_NAME=
OWNER_PASSWORD=
