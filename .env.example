# Copy to .env. Never commit .env.
# App role must NOT be a PostgreSQL superuser, otherwise row-level security is bypassed.
DATABASE_URL=postgres://orthoapp:orthoapp_local_only@127.0.0.1:5433/tracewell
TEST_DATABASE_URL=postgres://orthoapp:orthoapp_local_only@127.0.0.1:5433/tracewell_test
# Admin URL used only by scripts/db-local.sh to create the role/databases.
PGPORT_LOCAL=5433
PORT=3001
NODE_ENV=development
# 32+ random bytes; used to sign nothing secret-bearing in the pilot but required by config validation.
SESSION_SECRET=change-me-local-only-0123456789abcdef
# development only: shows one-click demo account buttons on the login page. Ignored when NODE_ENV=production.
DEMO_LOGIN_SHORTCUTS=true
# Demo clock: seed pins "now" to the demo anchor (today 08:00 America/Chicago) and the clock advances in real time.
DEMO_CLOCK=true
# Live integrations stay disabled until credentials, mappings, permissions and acceptance criteria exist.
LIVE_INTEGRATIONS_ENABLED=false
